{
	"name": "@wener/tiptap",
	"version": "1.0.0",
	"type": "module",
	"description": "Collection of useful tiptap extensions",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wener/wode.git"
	},
	"author": "wener",
	"license": "MIT",
	"main": "dist/cjs/index.js",
	"types": "src/index.ts",
	"module": "lib/index.js",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./lib/index.js",
			"require": "./dist/cjs/index.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"lib",
		"rollup.config.js",
		"src",
		"tsconfig.json",
		"types",
		"README.md"
	],
	"keywords": [
		"tiptap",
		"editor",
		"extension",
		"prosemirror"
	],
	"scripts": {
		"build": "make build",
		"clean": "rm -rf lib/*",
		"dev": "esbuild --watch --format=esm --outdir=lib/esm --target=chrome90 src/index.ts src/**/*.ts",
		"lint": "tsc --noEmit",
		"test": "make test"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18",
		"y-prosemirror": ">=1",
		"y-protocols": ">=1",
		"yjs": ">=13"
	},
	"dependencies": {
		"@tiptap/core": "^2.14.1",
		"@tiptap/extension-blockquote": "^2.14.1",
		"@tiptap/extension-bold": "^2.14.1",
		"@tiptap/extension-bubble-menu": "^2.14.1",
		"@tiptap/extension-bullet-list": "^2.14.1",
		"@tiptap/extension-character-count": "^2.14.1",
		"@tiptap/extension-code": "^2.14.1",
		"@tiptap/extension-code-block": "^2.14.1",
		"@tiptap/extension-collaboration": "^2.14.1",
		"@tiptap/extension-collaboration-cursor": "^2.14.1",
		"@tiptap/extension-color": "^2.14.1",
		"@tiptap/extension-document": "^2.14.1",
		"@tiptap/extension-dropcursor": "^2.14.1",
		"@tiptap/extension-floating-menu": "^2.14.1",
		"@tiptap/extension-focus": "^2.14.1",
		"@tiptap/extension-font-family": "^2.14.1",
		"@tiptap/extension-gapcursor": "^2.14.1",
		"@tiptap/extension-hard-break": "^2.14.1",
		"@tiptap/extension-heading": "^2.14.1",
		"@tiptap/extension-highlight": "^2.14.1",
		"@tiptap/extension-history": "^2.14.1",
		"@tiptap/extension-horizontal-rule": "^2.14.1",
		"@tiptap/extension-image": "^2.14.1",
		"@tiptap/extension-italic": "^2.14.1",
		"@tiptap/extension-link": "^2.14.1",
		"@tiptap/extension-list-item": "^2.14.1",
		"@tiptap/extension-mention": "^2.14.1",
		"@tiptap/extension-ordered-list": "^2.14.1",
		"@tiptap/extension-paragraph": "^2.14.1",
		"@tiptap/extension-placeholder": "^2.14.1",
		"@tiptap/extension-strike": "^2.14.1",
		"@tiptap/extension-subscript": "^2.14.1",
		"@tiptap/extension-superscript": "^2.14.1",
		"@tiptap/extension-table": "^2.14.1",
		"@tiptap/extension-table-cell": "^2.14.1",
		"@tiptap/extension-table-header": "^2.14.1",
		"@tiptap/extension-table-row": "^2.14.1",
		"@tiptap/extension-task-item": "^2.14.1",
		"@tiptap/extension-task-list": "^2.14.1",
		"@tiptap/extension-text": "^2.14.1",
		"@tiptap/extension-text-align": "^2.14.1",
		"@tiptap/extension-text-style": "^2.14.1",
		"@tiptap/extension-typography": "^2.14.1",
		"@tiptap/extension-underline": "^2.14.1",
		"@tiptap/html": "^2.14.1",
		"@tiptap/react": "^2.14.1",
		"@tiptap/starter-kit": "^2.14.1",
		"@tiptap/suggestion": "^2.14.1",
		"@wener/utils": "workspace:^1.1.51",
		"classnames": "^2.5.1",
		"linkify-it": "^5.0.0",
		"markdown-it": "^14.1.0",
		"mdurl": "^2.0.0",
		"prosemirror-markdown": "^1.13.2",
		"prosemirror-model": "^1.25.1",
		"prosemirror-state": "^1.4.3",
		"prosemirror-transform": "^1.10.4",
		"prosemirror-view": "^1.40.0",
		"y-prosemirror": "^1.3.5",
		"y-protocols": "^1.0.6",
		"yjs": "^13.6.27"
	},
	"devDependencies": {
		"@types/markdown-it": "^14.1.2",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"typescript": "^5.8.3"
	},
	"publishConfig": {
		"access": "public",
		"main": "dist/wener-tiptap.cjs.js",
		"umd": "dist/wener-tiptap.umd.js",
		"module": "dist/wener-tiptap.esm.js",
		"types": "lib/esm/index.d.ts",
		"exports": {
			".": {
				"types": "./src/index.ts",
				"import": "./lib/index.js",
				"require": "./dist/cjs/index.js"
			},
			"./src/*": "./src/*",
			"./package.json": "./package.json"
		}
	},
	"sideEffects": false,
	"ava": {
		"extensions": {
			"ts": "module"
		},
		"nodeArguments": [
			"--loader=tsx"
		]
	},
	"rollup": {},
	"typedoc": {
		"entryPoint": "./src/index.ts",
		"readmeFile": "./README.md"
	}
}
