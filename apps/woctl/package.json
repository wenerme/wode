{
	"name": "woctl",
	"version": "0.2.0",
	"type": "module",
	"description": "A command-line toolkit for search, MCP tools, AI models, and structured data",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wenerme/wode.git",
		"directory": "apps/woctl"
	},
	"homepage": "https://github.com/wenerme/wode/tree/develop/apps/woctl#readme",
	"engines": {
		"node": ">=24.11.0"
	},
	"bin": {
		"woctl": "./dist/cli.js"
	},
	"files": [
		"dist/cli.js",
		"README.md",
		"README.zh-Hans.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"exports": {
		"./node": {
			"types": "./src/node.ts",
			"development": "./src/node.ts",
			"default": "./src/node.ts"
		},
		"./web": {
			"development": "./src/web/index.ts",
			"default": "./src/web/index.ts"
		},
		"./shell": {
			"development": "./src/shell.ts",
			"default": "./src/shell.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "tsx src/cli/main.ts",
		"dev:web": "vite --host 127.0.0.1",
		"build": "pnpm run build:cli && pnpm run build:web && pnpm run build:site",
		"build:cli": "tsx scripts/build.ts cli",
		"build:web": "tsx scripts/build.ts web && tsx scripts/build.ts shell",
		"build:site": "vite build",
		"prepack": "node --import tsx scripts/build.ts cli",
		"docs:generate": "node --import tsx scripts/generate-reference.ts --write",
		"docs:check": "node --import tsx scripts/generate-reference.ts --check",
		"preview": "vite preview --host 127.0.0.1",
		"start": "node dist/cli.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@hyzyla/pdfium": "2.1.13",
		"canvaskit-wasm": "0.42.0",
		"excelize-wasm": "0.1.3",
		"pdfjs-dist": "6.4.299"
	},
	"devDependencies": {
		"@wener/common": "workspace:^",
		"@wener/client": "workspace:^",
		"common": "workspace:^",
		"just-bash": "^3.6.0",
		"ioredis": "^6.0.0",
		"ajv": "^8.20.0",
		"yaml": "^2.9.1",
		"@types/node": "^24.13.5",
		"@types/pg": "^8.23.1",
		"esbuild": "^0.28.2",
		"pg": "^8.23.0",
		"tsx": "^4.23.15",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
