{
	"name": "components",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "waku build",
		"build-storybook": "pnpm registry:build && storybook build",
		"check:source-lines": "node --test scripts/check-ui-source-lines.test.mjs && node scripts/check-ui-source-lines.mjs --root apps/components",
		"dev": "waku dev --port 3060",
		"start": "waku start",
		"deploy": "waku build && wrangler deploy",
		"pages:build": "pnpm build-storybook && pnpm storybook:check && node scripts/check-pages.mjs",
		"registry:build": "shadcn build && node scripts/sync-registry-catalog.mjs && pnpm exec biome format --write public/r src/generated/registry-catalog.json",
		"registry:policy-check": "node scripts/check-registry-policy.mjs",
		"registry:policy-test": "node scripts/check-registry-policy-fixture.mjs",
		"registry:consumer-check": "node scripts/check-registry-consumers.mjs",
		"registry:consumer-test": "node --test scripts/run-child-command.test.mjs scripts/run-sync-command.test.mjs scripts/registry-consumer-packages.test.mjs",
		"registry:check": "node scripts/check-registry.mjs && pnpm registry:policy-check && pnpm registry:policy-test && pnpm registry:consumer-test",
		"router:typegen": "waku router typegen",
		"router:check": "node scripts/check-router-typegen.mjs",
		"storybook": "storybook dev -p 6053 --no-open",
		"storybook:check": "node scripts/check-story-structure.mjs && node scripts/check-story-structure-fixture.mjs",
		"test:storybook": "node ../../scripts/run-ci-tests.mjs storybook",
		"test": "node ../../scripts/run-ci-tests.mjs components",
		"typecheck": "pnpm --workspace-root exec tsc --noEmit --project apps/components/tsconfig.json",
		"verify": "pnpm router:check && pnpm check:source-lines && pnpm typecheck && pnpm test && pnpm test:storybook && pnpm storybook:check && pnpm registry:check && pnpm registry:consumer-check && pnpm build && pnpm pages:build"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.53",
		"@ai-sdk/react": "^4.0.110",
		"@base-ui/react": "^1.8.0",
		"@phosphor-icons/react": "^2.1.10",
		"@shadcn/react": "^0.3.1",
		"@tanstack/react-db": "^0.4.1",
		"@wener/ai": "workspace:^0.1.21",
		"@wener/common": "workspace:^3.0.0",
		"@wener/ui": "workspace:^0.1.0",
		"ai": "^7.0.107",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dexie": "^4.4.6",
		"emittery": "^2.0.0",
		"lucide-react": "^1.47.0",
		"mutative": "^1.3.0",
		"re-resizable": "^6.11.2",
		"react": "~19.3.0",
		"react-arborist": "^3.16.0",
		"react-dom": "~19.3.0",
		"react-hook-form": "^7.88.0",
		"react-resizable-panels": "^4.12.4",
		"react-router": "^8.4.0",
		"react-server-dom-webpack": "~19.3.0",
		"shadcn": "^4.21.0",
		"streamdown": "^2.6.0",
		"tailwind-merge": "^3.7.0",
		"waku": "^1.0.0-rc.1",
		"web-vitals": "^6.2.2",
		"zod": "^4.6.5",
		"zustand": "^5.0.15",
		"zustand-mutative": "^1.3.1"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.6.0",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-links": "^10.6.0",
		"@storybook/addon-mcp": "^10.6.0",
		"@storybook/addon-vitest": "^10.6.0",
		"@storybook/react": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@swc/core": "^1.16.2",
		"@tailwindcss/vite": "^4.3.3",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"daisyui": "^5.7.42",
		"fake-indexeddb": "6.2.5",
		"storybook": "^10.6.0",
		"vitest": "catalog:",
		"wrangler": "^4.135.0"
	}
}
