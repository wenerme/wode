{
	"name": "woctl",
	"version": "0.1.1",
	"type": "module",
	"description": "Wode CLI 与浏览器命令宿主",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wenerme/wode.git",
		"directory": "apps/wocli"
	},
	"homepage": "https://github.com/wenerme/wode#readme",
	"engines": {
		"node": ">=24.11.0"
	},
	"bin": {
		"woctl": "./dist/cli.js",
		"wocli": "./dist/cli.js"
	},
	"files": [
		"dist/cli.js",
		"README.md",
		"README.zh-Hans.md"
	],
	"exports": {
		"./web": {
			"development": "./src/web.ts",
			"default": "./src/web.ts"
		},
		"./shell": {
			"development": "./src/shell.ts",
			"default": "./src/shell.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "tsx src/cli.ts",
		"dev:web": "vite --host 127.0.0.1",
		"build": "pnpm run build:cli && pnpm run build:web && pnpm run build:site",
		"build:cli": "tsx scripts/build.ts cli",
		"build:web": "tsx scripts/build.ts web && tsx scripts/build.ts shell",
		"build:site": "vite build",
		"prepack": "node --import tsx scripts/build.ts cli",
		"preview": "vite preview --host 127.0.0.1",
		"start": "node dist/cli.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {},
	"devDependencies": {
		"@wener/common": "workspace:^",
		"@wener/client": "workspace:^",
		"common": "workspace:^",
		"just-bash": "^3.6.0",
		"yaml": "^2.9.1",
		"@types/node": "^24.13.5",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.15",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
