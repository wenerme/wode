{
	"name": "@wener/mcp-cli",
	"version": "0.1.5",
	"type": "module",
	"description": "A lightweight CLI for interacting with MCP (Model Context Protocol) servers",
	"repository": {
		"type": "git",
		"url": "https://github.com/wenerme/wode.git",
		"directory": "packages/wener-mcp-cli"
	},
	"homepage": "https://github.com/wenerme/wode/tree/main/packages/wener-mcp-cli",
	"author": "wener",
	"license": "MIT",
	"engines": {
		"node": ">=24.11.0"
	},
	"bin": {
		"mcp-cli": "./dist/index.mjs"
	},
	"main": "./dist/index.mjs",
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"keywords": [
		"mcp",
		"model-context-protocol",
		"cli",
		"ai",
		"tools",
		"agents",
		"claude",
		"cursor",
		"gemini"
	],
	"scripts": {
		"build": "tsx src/scripts/bundle.ts",
		"dev": "tsx src/index.ts",
		"fmt": "pnpm exec biome format --write src",
		"prepublishOnly": "pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@types/node": "^24.13.5",
		"@wener/utils": "workspace:^1.1.59",
		"commander": "^15.0.0",
		"common": "workspace:^1.0.0",
		"esbuild": "^0.28.2",
		"smol-toml": "^1.8.0",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.15",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"zod": "^4.6.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
