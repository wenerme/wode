{
	"name": "@wener/mcp-cli",
	"version": "0.1.3",
	"type": "module",
	"description": "A lightweight CLI for interacting with MCP (Model Context Protocol) servers",
	"repository": {
		"type": "git",
		"url": "https://github.com/wenerme/wode.git",
		"directory": "packages/wener-mcp-cli"
	},
	"homepage": "https://github.com/wenerme/wode/tree/main/packages/wener-mcp-cli",
	"author": "wener",
	"license": "MIT",
	"engines": {
		"node": ">=18.0.0"
	},
	"bin": {
		"mcp-cli": "./dist/index.mjs"
	},
	"main": "./dist/index.mjs",
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"keywords": [
		"mcp",
		"model-context-protocol",
		"cli",
		"ai",
		"tools",
		"agents",
		"claude",
		"cursor",
		"gemini"
	],
	"scripts": {
		"build": "tsx src/scripts/bundle.ts",
		"dev": "tsx src/index.ts",
		"fmt": "pnpm prettier --write src",
		"prepublishOnly": "pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.25.2",
		"@types/node": "^24.10.7",
		"commander": "^13.1.0",
		"esbuild": "^0.27.2",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.4",
		"typescript": "^5.9.3",
		"vitest": "^3.1.3",
		"zod": "^3.24.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"smol-toml": "^1.6.0"
	}
}
