{
	"extends": ["../../tsconfig.base.json"],
	"compilerOptions": {
		"moduleResolution": "bundler",
		"lib": ["dom", "dom.iterable", "ES2018"],
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"pretty": true,
		"removeComments": false,
		"stripInternal": true
	},
	"exclude": ["node_modules"],
	"include": ["src"]
}
