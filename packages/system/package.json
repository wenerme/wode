{
	"name": "@wener/system",
	"version": "1.0.6",
	"type": "module",
	"description": "Utils for systemjs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wener/wode.git"
	},
	"homepage": "https://github.com/wenerme/wode#readme",
	"author": "wener",
	"license": "MIT",
	"main": "dist/cjs/index.js",
	"types": "src/index.ts",
	"module": "lib/index.js",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"typescript": "./src/index.ts",
			"import": "./lib/index.js",
			"require": "./dist/cjs/index.js"
		},
		"./server": {
			"types": "./src/server.ts",
			"typescript": "./src/server.ts",
			"import": "./lib/server.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"index.ts",
		"lib",
		"server.ts",
		"src",
		"tsconfig.json"
	],
	"keywords": [
		"utils",
		"system",
		"helper"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "just -f ../../just/packages/system.just build",
		"clean": "just -f ../../just/package.just package-clean",
		"dev": "just -f ../../just/packages/system.just dev",
		"test": "just -f ../../just/package.just package-test"
	},
	"peerDependencies": {
		"node-fetch": "*",
		"systemjs": "*"
	},
	"peerDependenciesMeta": {
		"node-fetch": {
			"optional": true
		},
		"systemjs": {
			"optional": true
		}
	},
	"optionalDependencies": {
		"node-fetch": "^3.3.2",
		"systemjs": "^6.15.1"
	},
	"devDependencies": {
		"@types/jsdom": "^30.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@wener/utils": "workspace:^1.1.59",
		"jsdom": "^30.1.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public",
		"exports": {
			".": {
				"types": "./src/index.ts",
				"typescript": "./src/index.ts",
				"import": "./lib/index.js",
				"require": "./dist/cjs/index.js"
			},
			"./server": {
				"types": "./src/server.ts",
				"typescript": "./src/server.ts",
				"import": "./lib/server.js"
			},
			"./src/*": "./src/*",
			"./package.json": "./package.json"
		}
	},
	"sideEffects": false
}
