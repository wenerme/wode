{
	"name": "@wener/common",
	"version": "3.0.0",
	"type": "module",
	"description": "Common utils for console & server",
	"repository": {
		"type": "git",
		"url": "https://github.com/wenerme/wener.git",
		"directory": "packages/wener-common"
	},
	"homepage": "https://github.com/wenerme/wener/tree/main/packages/wener-common",
	"author": "wener",
	"license": "MIT",
	"engines": {
		"node": ">=24.11.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json",
		"./cli/*": "./src/cli/*.ts",
		"./cli/render": "./src/cli/render/index.ts",
		"./*": "./src/*/index.ts",
		"./fs/s3mini": "./src/fs/s3/index.ts"
	},
	"files": [
		"lib",
		"lib.d.ts",
		"libs",
		"src"
	],
	"keywords": [],
	"scripts": {
		"build": "just -f ../../just/packages/wener-common.just build",
		"check:fs-mime-types": "node scripts/generateMimeTypes.mjs --check",
		"generate:fs-mime-types": "node scripts/generateMimeTypes.mjs",
		"prepublishOnly": "pnpm verify:publish",
		"test": "pnpm --workspace-root exec vitest run --project @wener/common",
		"test:built": "node ./tests/built-publish-subpath-smoke.mjs",
		"typecheck": "tsc --noEmit",
		"verify:publish": "pnpm --filter @wener/utils build && pnpm build && pnpm test:built"
	},
	"peerDependencies": {
		"ajv": "*",
		"just-bash": "^3.1.0",
		"zod": "*"
	},
	"peerDependenciesMeta": {
		"just-bash": {
			"optional": true
		}
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.52",
		"@standard-schema/spec": "^1.1.0",
		"@types/wicg-file-system-access": "^2023.10.7",
		"@wener/client": "workspace:^",
		"@wener/utils": "workspace:^",
		"ajv-formats": "^3.0.1",
		"ajv-keywords": "^5.1.0",
		"consola": "^3.4.2",
		"date-fns": "^4.4.0",
		"es-toolkit": "^1.53.1",
		"pathe": "^2.0.3",
		"std-env": "^4.3.0",
		"string-width": "^8.3.0",
		"ts-pattern": "^5.9.2",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@mikro-orm/core": "^7.2.7",
		"@mikro-orm/sql": "^7.2.7",
		"@orpc/client": "^1.16.1",
		"@orpc/contract": "^1.16.1",
		"@orpc/openapi-client": "^1.16.1",
		"@orpc/server": "^1.16.1",
		"@sinclair/typebox-codegen": "^0.11.1",
		"@types/argon2-browser": "^1.18.4",
		"@types/bcrypt": "^6.0.0",
		"@types/micromatch": "^4.0.10",
		"@types/mime-types": "^3.0.1",
		"ajv-i18n": "^4.2.0",
		"argon2": "^0.45.2",
		"argon2-browser": "^1.18.0",
		"bcrypt": "^6.0.0",
		"bcryptjs": "^3.0.3",
		"chalk": "^6.0.1",
		"dayjs": "^1.11.23",
		"decimal.js": "^10.6.0",
		"emittery": "^2.2.0",
		"just-bash": "^3.6.0",
		"kysely": "^0.29.8",
		"micromatch": "^4.0.8",
		"mime-types": "^3.0.2",
		"minio": "^8.0.7",
		"s3mini": "^1.0.3",
		"webdav": "^5.11.0",
		"zod": "^4.6.7"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./src/index.ts",
				"default": "./lib/index.js"
			},
			"./package.json": "./package.json",
			"./cli/*": {
				"types": "./src/cli/*.ts",
				"default": "./lib/cli/*.js"
			},
			"./cli/render": {
				"types": "./src/cli/render/index.ts",
				"default": "./lib/cli/render/index.js"
			},
			"./*": {
				"types": "./src/*/index.ts",
				"default": "./lib/*/index.js"
			},
			"./fs/s3mini": {
				"types": "./src/fs/s3/index.ts",
				"default": "./lib/fs/s3/index.js"
			}
		}
	}
}
