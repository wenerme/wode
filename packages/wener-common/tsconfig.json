{
	"extends": ["../../tsconfig.base.json"],
	"compilerOptions": {
		"experimentalDecorators": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"pretty": true,
		"removeComments": false,
		"stripInternal": true,
		"jsx": "react-jsx",
		"outDir": "lib",
		"rootDir": "./src"
	},
	"exclude": [
		"node_modules",
		"src/fs/server/createDatabaseFileSystem.ts",
		"src/fs/server/dbfs.test.ts",
		"src/fs/server/loadTestDatabase.ts"
	],
	"include": ["src"]
}
