{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"types": ["node"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noImplicitAny": false,
		"paths": {
			"#/*": ["./src/*"]
		}
	},
	"include": ["src/**/*", "tests/**/*", "*.ts"],
	"exclude": ["node_modules", "dist"]
}
