{
	"name": "@wener/utils",
	"version": "1.1.56",
	"type": "module",
	"description": "Utils for daily use",
	"repository": {
		"type": "git",
		"url": "https://github.com/wenerme/wener.git",
		"directory": "packages/wener-utils"
	},
	"homepage": "https://github.com/wenerme/wener/tree/main/packages/wener-utils",
	"author": "wener",
	"license": "MIT",
	"imports": {
		"#/*": "./src/*"
	},
	"exports": {
		".": "./src/index.ts",
		"./logger": "./src/logger/index.ts",
		"./schema/typebox": "./src/schema/typebox/index.ts",
		"./schema/typebox/gen": "./src/schema/typebox/gen/index.ts",
		"./server": "./src/server/index.ts",
		"./server/jsdom": "./src/server/jsdom.ts",
		"./server/node-fetch": "./src/server/node-fetch.ts",
		"./server/ws": "./src/server/ws.ts",
		"./types": "./src/types.d.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src",
		"tsconfig.json"
	],
	"keywords": [
		"utils",
		"core library",
		"helper",
		"camelcase",
		"get",
		"set",
		"template",
		"lodash"
	],
	"scripts": {
		"build": "make build",
		"clean": "make clean",
		"dev": "make dev",
		"test": "make test"
	},
	"devDependencies": {
		"@sinclair/typebox": "^0.34.41",
		"@types/ws": "^8.18.1",
		"https-proxy-agent": "^7.0.6",
		"node-fetch": "^3.3.2",
		"undici": "^7.16.0",
		"zod": "^4.2.1"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public",
		"exports": {
			".": {
				"types": "./src/index.ts",
				"default": "./lib/index.js"
			},
			"./logger": {
				"types": "./src/logger/index.ts",
				"default": "./lib/logger/index.js"
			},
			"./schema/typebox": {
				"types": "./src/schema/typebox/index.ts",
				"default": "./lib/schema/typebox/index.js"
			},
			"./schema/typebox/gen": {
				"types": "./src/schema/typebox/gen/index.ts",
				"default": "./lib/schema/typebox/gen/index.js"
			},
			"./server": {
				"types": "./src/server/index.ts",
				"default": "./lib/server/index.js"
			},
			"./server/jsdom": {
				"types": "./src/server/jsdom.ts",
				"default": "./lib/server/jsdom.js"
			},
			"./server/node-fetch": {
				"types": "./src/server/node-fetch.ts",
				"default": "./lib/server/node-fetch.js"
			},
			"./server/ws": {
				"types": "./src/server/ws.ts",
				"default": "./lib/server/ws.js"
			},
			"./types": {
				"types": "./src/types.d.ts",
				"default": "./lib/types.d.js"
			},
			"./package.json": "./package.json"
		}
	},
	"sideEffects": false
}
