{
	"extends": ["../../tsconfig.base.json"],
	"compilerOptions": {
		"sourceMap": true,
		"erasableSyntaxOnly": false,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"pretty": true,
		"removeComments": false,
		"stripInternal": true,
		"outDir": "lib",
		"rootDir": "./src",
		"paths": {
			"#/*": ["./src/*"]
		}
	},
	"exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts"],
	"include": ["src/types.d.ts", "src"]
}
