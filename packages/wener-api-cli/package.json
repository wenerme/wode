{
	"name": "@wener/api-cli",
	"version": "0.1.1",
	"type": "module",
	"description": "A lightweight CLI for interacting with REST APIs via OpenAPI specifications",
	"repository": {
		"type": "git",
		"url": "https://github.com/wenerme/wode.git",
		"directory": "packages/wener-api-cli"
	},
	"homepage": "https://github.com/wenerme/wode/tree/main/packages/wener-api-cli",
	"author": "wener",
	"license": "MIT",
	"engines": {
		"node": ">=24.11.0"
	},
	"bin": {
		"api-cli": "./dist/index.mjs"
	},
	"main": "./dist/index.mjs",
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"keywords": [
		"openapi",
		"swagger",
		"rest",
		"api",
		"cli",
		"http",
		"client"
	],
	"scripts": {
		"build": "tsx src/scripts/bundle.ts",
		"dev": "tsx src/index.ts",
		"fmt": "vp fmt src package.json tsconfig.json vitest.config.ts",
		"prepublishOnly": "pnpm build",
		"test": "vp test run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/node": "^24.13.5",
		"commander": "^15.0.0",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.13",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
		"vite-plus": "catalog:",
		"zod": "^4.6.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
