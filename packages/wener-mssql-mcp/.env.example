# MSSQL MCP Server Environment Configuration
# Copy this file and customize it for your SQL Server setup

# Required: SQL Server connection details
MSSQL_SERVER=localhost
MSSQL_DATABASE=your_database_name

# SQL Server Authentication (default)
MSSQL_USER=your_username
MSSQL_PASSWORD=your_password

# OR Windows Authentication (uncomment to use)
# MSSQL_WINDOWS_AUTH=true
# Note: When using Windows auth, MSSQL_USER and MSSQL_PASSWORD are not needed

# Optional: Port configuration (default: 1433)
MSSQL_PORT=1433

# Optional: Force encryption (default: false)
# Set to true for secure connections or Azure SQL
MSSQL_ENCRYPT=false

# Optional: Access mode control (default: readwrite)
# Set to 'readonly' to restrict to SELECT, WITH, SHOW, DESCRIBE, EXPLAIN, DESC queries only
# Set to 'readwrite' to allow all SQL operations (INSERT, UPDATE, DELETE, etc.)
# Note: Uses explicit BEGIN TRANSACTION/COMMIT TRANSACTION SQL commands for SQL Server 2008 compatibility
MSSQL_ACCESS_MODE=readwrite

# Optional: Custom tool command name (default: execute_sql)
MSSQL_COMMAND=execute_sql

# Examples for different connection types:

# LocalDB example:
# MSSQL_SERVER=(localdb)\MSSQLLocalDB
# MSSQL_DATABASE=MyLocalDatabase
# MSSQL_WINDOWS_AUTH=true

# Azure SQL example:
# MSSQL_SERVER=your-server.database.windows.net
# MSSQL_DATABASE=your_azure_database
# MSSQL_USER=your_azure_username
# MSSQL_PASSWORD=your_azure_password
# Note: MSSQL_ENCRYPT will be automatically set to true for Azure SQL

# Windows Authentication example:
# MSSQL_SERVER=localhost
# MSSQL_DATABASE=AdventureWorks2019
# MSSQL_WINDOWS_AUTH=true

# Development/Testing example (SQL Auth):
# MSSQL_SERVER=localhost
# MSSQL_DATABASE=AdventureWorks2019
# MSSQL_USER=sa
# MSSQL_PASSWORD=YourStrong!Passw0rd

# Read-only mode example:
# MSSQL_SERVER=prod-server.company.com
# MSSQL_DATABASE=ProductionDB
# MSSQL_USER=readonly_user
# MSSQL_PASSWORD=readonly_password
# MSSQL_ACCESS_MODE=readonly
