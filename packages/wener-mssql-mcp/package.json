{
	"name": "@wener/mssql-mcp",
	"version": "1.0.1",
	"type": "module",
	"description": "Microsoft SQL Server MCP (Model Context Protocol) server with SQL query execution and Windows Authentication support",
	"repository": {
		"type": "git",
		"url": "https://github.com/wenerme/wener.git",
		"directory": "packages/wener-mssql-mcp"
	},
	"homepage": "https://github.com/wenerme/wener/tree/main/packages/wener-mssql-mcp",
	"author": "wener",
	"license": "MIT",
	"engines": {
		"node": ">=24.11.0"
	},
	"bin": {
		"mssql-mcp": "./dist/main.mjs"
	},
	"main": "./dist/main.mjs",
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"keywords": [
		"mcp",
		"mssql",
		"sql-server",
		"model-context-protocol",
		"claude",
		"anthropic",
		"database",
		"ai-tools"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "tsx src/scripts/bundle.ts",
		"clean": "rm -rf dist",
		"dev": "tsx src/main.ts",
		"prepublishOnly": "pnpm build"
	},
	"devDependencies": {
		"@hono/mcp": "^0.3.2",
		"@hono/node-server": "^2.1.1",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@types/mssql": "^12.3.0",
		"@types/node": "^24.13.5",
		"commander": "^15.0.0",
		"consola": "^3.4.2",
		"dotenv": "^16.6.1",
		"esbuild": "^0.28.2",
		"hono": "^4.13.8",
		"hono-rate-limiter": "^0.5.4",
		"mssql": "^12.7.2",
		"tsx": "^4.23.13",
		"typescript": "7.0.2",
		"zod": "^4.6.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
