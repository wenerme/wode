{
	"name": "@wener/mssql-mcp",
	"version": "1.0.1",
	"type": "module",
	"description": "Microsoft SQL Server MCP (Model Context Protocol) server with SQL query execution and Windows Authentication support",
	"repository": {
		"type": "git",
		"url": "https://github.com/wenerme/wener.git",
		"directory": "packages/wener-mssql-mcp"
	},
	"homepage": "https://github.com/wenerme/wener/tree/main/packages/wener-mssql-mcp",
	"author": "wener",
	"license": "MIT",
	"engines": {
		"node": ">=18.0.0"
	},
	"bin": {
		"mssql-mcp": "./dist/main.mjs"
	},
	"main": "./dist/main.mjs",
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"keywords": [
		"mcp",
		"mssql",
		"sql-server",
		"model-context-protocol",
		"claude",
		"anthropic",
		"database",
		"ai-tools"
	],
	"scripts": {
		"build": "node --loader ts-node/esm src/scripts/bundle.ts",
		"clean": "rm -rf dist",
		"dev": "node --loader ts-node/esm src/main.ts",
		"prepublishOnly": "pnpm build"
	},
	"devDependencies": {
		"@hono/mcp": "^0.2.3",
		"@hono/node-server": "^1.19.8",
		"@modelcontextprotocol/sdk": "^1.25.2",
		"@types/mssql": "^9.1.8",
		"@types/node": "^24.10.7",
		"commander": "^14.0.2",
		"consola": "^3.4.2",
		"dotenv": "^16.6.1",
		"esbuild": "^0.27.2",
		"hono": "^4.11.3",
		"mssql": "^12.2.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"zod": "^4.3.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
