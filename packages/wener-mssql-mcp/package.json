	"author": "wener",
	"license": "MIT",
	"engines": {
		"node": ">=24.11.0"
	},
	"bin": {
		"mssql-mcp": "./dist/main.mjs"
	},
	"main": "./dist/main.mjs",
	"files": ["dist", "src", "README.md"],
