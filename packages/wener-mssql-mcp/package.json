		"commander": "^15.0.0",
		"consola": "^3.4.2",
		"dotenv": "^16.6.1",
		"esbuild": "^0.28.1",
		"hono": "^4.12.28",
		"hono-rate-limiter": "^0.5.3",
		"mssql": "^12.7.0",
