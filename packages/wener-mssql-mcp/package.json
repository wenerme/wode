{
	"name": "@wener/mssql-mcp",
	"version": "1.0.1",
	"type": "module",
	"description": "Microsoft SQL Server MCP (Model Context Protocol) server with SQL query execution and Windows Authentication support",
	"author": "wener",
	"license": "MIT",
	"engines": {
		"node": ">=18.0.0"
	},
	"bin": {
		"mssql-mcp": "./dist/main.mjs"
	},
	"main": "./dist/main.mjs",
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"keywords": [
		"mcp",
		"mssql",
		"sql-server",
		"model-context-protocol",
		"claude",
		"anthropic",
		"database",
		"ai-tools"
	],
	"scripts": {
		"build": "node --loader ts-node/esm src/scripts/bundle.ts",
		"clean": "rm -rf dist",
		"dev": "node --loader ts-node/esm src/main.ts",
		"prepublishOnly": "pnpm build"
	},
	"devDependencies": {
		"@hono/mcp": "^0.1.5",
		"@hono/node-server": "^1.19.6",
		"@modelcontextprotocol/sdk": "^1.21.1",
		"@types/node": "^22.19.0",
		"commander": "^14.0.2",
		"consola": "^3.4.2",
		"dotenv": "^16.6.1",
		"esbuild": "^0.26.0",
		"hono": "^4.10.4",
		"mssql": "^12.1.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"zod": "^4.1.12"
	},
	"publishConfig": {
		"access": "public"
	}
}
