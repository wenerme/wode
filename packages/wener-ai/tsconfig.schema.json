{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": [
		"src/schema/**/*",
		"src/agent/**/*",
		"src/mcp/index.ts",
		"src/mcp/McpServerConfig.ts",
		"src/mcp/McpServerDef.ts",
		"tests/**/*"
	],
	"exclude": ["node_modules", "lib"]
}
