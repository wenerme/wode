{
	"name": "@wener/feishu-devdocs-mcp",
	"version": "1.0.0",
	"type": "module",
	"description": "Feishu/Lark Developer Documentation MCP server with search and recall capabilities",
	"repository": {
		"type": "git",
		"url": "https://github.com/wenerme/wener.git",
		"directory": "packages/wener-feishu-devdocs-mcp"
	},
	"homepage": "https://github.com/wenerme/wener/tree/main/packages/wener-feishu-devdocs-mcp",
	"author": "wener",
	"license": "MIT",
	"engines": {
		"node": ">=18.0.0"
	},
	"bin": {
		"feishu-devdocs-mcp": "./dist/main.mjs"
	},
	"main": "./dist/main.mjs",
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"keywords": [
		"mcp",
		"feishu",
		"lark",
		"developer-docs",
		"documentation",
		"search",
		"recall",
		"model-context-protocol",
		"ai-tools"
	],
	"scripts": {
		"build": "pnpm tsx src/scripts/bundle.ts",
		"clean": "rm -rf dist",
		"dev": "pnpm tsx --watch src/main.ts --http",
		"prepublishOnly": "pnpm build"
	},
	"devDependencies": {
		"@hono/mcp": "^0.2.2",
		"@hono/node-server": "^1.19.7",
		"@modelcontextprotocol/sdk": "^1.25.1",
		"@orpc/contract": "^1.13.0",
		"@orpc/server": "^1.13.0",
		"@types/node": "^24.10.4",
		"@wener/utils": "^1.1.56",
		"commander": "^14.0.2",
		"common": "workspace:^1.0.0",
		"consola": "^3.4.2",
		"dotenv": "^16.6.1",
		"hono": "^4.11.1",
		"zod": "^4.2.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
