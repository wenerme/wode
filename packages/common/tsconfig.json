{
	"extends": ["../../tsconfig.base.json"],
	"compilerOptions": {
		"sourceMap": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"pretty": true,
		"removeComments": false,
		"stripInternal": true,
		"outDir": "lib",
		"jsx": "react-jsx",
		"rootDir": "./src",
		"paths": {
			"@/*": ["./src/*"],
			"#/*": ["./src/*"]
		}
	},
	"exclude": [
		"node_modules",
		"src/alpine/createTypeGraphSchema.ts",
		"src/poc/bbvm/bbvm.main.ts",
		"src/poc/bbvm/runBbvm.ts",
		"src/poc/cli/**",
		"src/poc/contracts/**",
		"src/poc/gost/**",
		"src/poc/ignored/**",
		"src/poc/netflix/**",
		"src/poc/react-serialize/**"
	],
	"include": ["next-env.d.ts", "src"]
}
