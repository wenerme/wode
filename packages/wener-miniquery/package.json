	"scripts": {
		"build": "make build",
		"deploy": "make deploy",
		"test": "make test"
	},
	"dependencies": {
		"@wener/utils": "workspace:^1.1.58",
		"ts-pattern": "^5.9.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.3.15",
		"@electric-sql/pglite-socket": "^0.0.21",
		"@mikro-orm/core": "7.0.0-rc.2",
		"@mikro-orm/decorators": "7.0.0-rc.2",
		"@mikro-orm/postgresql": "7.0.0-rc.2",
		"@mikro-orm/sql": "7.0.0-rc.2",
		"@sequelize/core": "7.0.0-alpha.48",
		"ohm-js": "^17.5.0"
