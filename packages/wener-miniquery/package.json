				"types": "./src/doc/index.ts",
				"default": "./lib/doc/index.js"
			},
			"./mikro-orm": {
				"types": "./src/mikro-orm/index.ts",
				"default": "./lib/mikro-orm/index.js"
			},
			"./search": {
				"types": "./src/search/index.ts",
				"default": "./lib/search/index.js"
			},
			"./package.json": "./package.json"
