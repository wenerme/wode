{
	"$schema": "https://turborepo.org/schema.json",
	"globalDependencies": [
		"justfile",
		"just/**/*.just",
		"package.json",
		"tsconfig.json",
		"pnpm-lock.yaml",
		"rollup.config.ts",
		"rollup.config.js"
	],
	"globalEnv": ["CI_COMMIT_TAG", "CI_COMMIT_BRANCH"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "lib/**", "builds/*/app/**", ".next/**", "!.next/cache/**"],
			"inputs": ["$TURBO_DEFAULT$", "!lib/**", "!dist/**", "!.just-package-staging/**"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"clean": {
			"cache": false,
			"outputs": []
		},
		"dev": {
			"cache": false
		}
	}
}
