{
	"name": "@wener/wode",
	"version": "1.0.0",
	"type": "module",
	"description": "Wener Node Monorepo",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wenerme/wode.git"
	},
	"homepage": "https://github.com/wenerme/wode#readme",
	"bugs": {
		"url": "https://github.com/wenerme/wode/issues"
	},
	"author": "wener",
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=24.11.0",
		"npm": ">=11.0.0",
		"pnpm": ">=12.4.2"
	},
	"keywords": [],
	"scripts": {
		"typecheck": "pnpm -r --no-bail run typecheck",
		"lint": "biome lint .",
		"check": "biome lint .",
		"build": "just build",
		"dev": "just dev",
		"duplicates:report": "jscpd --config .jscpd.json --workers 4 apps/server/src apps/console/src packages/wener-server/src packages/wener-client/src packages/wener-common/src packages/wener-utils/src packages/wener-ai/src packages/common/src",
		"format": "just fmt",
		"preinstall": "npx only-allow pnpm"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@bufbuild/protoc-gen-es": "^2.16.0",
		"@connectrpc/protoc-gen-connect-query": "^2.3.1",
		"@swc/cli": "^0.8.2",
		"@swc/core": "^1.16.21",
		"@swc/helpers": "^0.5.24",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"@types/fs-extra": "^11.0.4",
		"@types/jsdom": "^30.0.0",
		"@types/lodash": "^4.17.27",
		"@types/node": "^24.13.5",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"autoprefixer": "^10.6.2",
		"bun-types": "^1.4.4",
		"cssnano": "^9.9.0",
		"daisyui": "^5.7.50",
		"esbuild": "^0.28.2",
		"globby": "^16.2.4",
		"jscpd": "^5.4.2",
		"jsdom": "^30.1.3",
		"million": "^3.1.11",
		"pg": "^8.23.1",
		"pg-hstore": "^2.3.4",
		"postcss": "^8.5.32",
		"postcss-import": "^17.0.1",
		"tailwindcss": "^4.3.4",
		"tailwindcss-animate": "^1.0.7",
		"ts-add-js-extension": "^1.6.6",
		"tslib": "^2.9.1",
		"tsx": "^4.23.15",
		"turbo": "^2.11.10",
		"typescript": "7.0.2",
		"vite": "^8.3.0",
		"vitest": "catalog:",
		"wrangler": "^4.157.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"lint-staged": {
		"**/*": "biome check --write"
	}
}
