{
	"name": "@wener/wode",
	"version": "1.0.0",
	"type": "module",
	"description": "Wener Node Monorepo",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wenerme/wode.git"
	},
	"homepage": "https://github.com/wenerme/wode#readme",
	"bugs": {
		"url": "https://github.com/wenerme/wode/issues"
	},
	"author": "wener",
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=24.11.0",
		"npm": ">=11.0.0",
		"pnpm": ">=12.4.2"
	},
	"keywords": [],
	"scripts": {
		"typecheck": "pnpm -r --no-bail run typecheck",
		"lint": "vp lint",
		"check": "vp check",
		"build": "just build",
		"check:ui-source-lines": "node --test apps/components/scripts/check-ui-source-lines.test.mjs && node apps/components/scripts/check-ui-source-lines.mjs",
		"dev": "just dev",
		"duplicates:report": "jscpd --config .jscpd.json --workers 4 apps/server/src apps/console/src packages/wener-server/src packages/wener-client/src packages/wener-common/src packages/wener-utils/src packages/wener-ai/src packages/common/src",
		"format": "just fmt",
		"preinstall": "npx only-allow pnpm"
	},
	"devDependencies": {
		"@bufbuild/protoc-gen-es": "^2.15.0",
		"@connectrpc/protoc-gen-connect-query": "^2.3.1",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.16.2",
		"@swc/helpers": "^0.5.23",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/fs-extra": "^11.0.4",
		"@types/jsdom": "^28.0.3",
		"@types/lodash": "^4.17.25",
		"@types/node": "^24.13.5",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/browser-playwright": "catalog:",
		"autoprefixer": "^10.6.1",
		"better-sqlite3": "^12.11.1",
		"bun-types": "^1.4.2",
		"cssnano": "^8.0.10",
		"daisyui": "^5.7.40",
		"esbuild": "^0.28.2",
		"globby": "^16.2.4",
		"jscpd": "5.0.12",
		"jsdom": "^29.1.1",
		"million": "^3.1.11",
		"pg": "^8.23.0",
		"pg-hstore": "^2.3.4",
		"playwright": "^1.63.0",
		"postcss": "^8.5.28",
		"postcss-import": "^16.2.0",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"ts-add-js-extension": "^1.6.6",
		"ts-node": "11.0.0-beta.1",
		"tslib": "^2.8.1",
		"tsx": "^4.23.13",
		"turbo": "^2.10.13",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
		"vite-plus": "catalog:",
		"vitest": "4.1.10",
		"wrangler": "^4.134.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"lint-staged": {
		"**/*": "vp fmt"
	}
}
