{
  "name": "@wener/wode",
  "version": "1.0.0",
  "type": "module",
  "description": "Wener Node Monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenerme/wode.git"
  },
  "homepage": "https://github.com/wenerme/wode#readme",
  "bugs": {
    "url": "https://github.com/wenerme/wode/issues"
  },
  "author": "wener",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "components/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18",
    "npm": ">=9.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [],
  "scripts": {
    "build": "turbo run build --filter='!@wener/system'",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.10.0",
    "@connectrpc/protoc-gen-connect-query": "^2.2.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.14.0",
    "@swc/helpers": "^0.5.17",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^27.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitejs/plugin-react-swc": "^4.2.0",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^12.4.1",
    "bun-types": "^1.3.1",
    "cssnano": "^7.1.2",
    "daisyui": "^5.4.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "^2.32.0",
    "globby": "^15.0.0",
    "jsdom": "^27.1.0",
    "million": "^3.1.11",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-pkg": "^0.21.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.1.16",
    "tailwindcss-animate": "^1.0.7",
    "ts-add-js-extension": "^1.6.6",
    "ts-node": "11.0.0-beta.1",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "turbo": "^2.6.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@10.20.0"
}
